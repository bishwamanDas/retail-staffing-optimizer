# Store Staffing Analyzer runtime configuration
# Copy to ".env" and adjust:  cp .env.example .env
# Every variable is optional - the defaults shown are the built-in defaults.
#
# All application settings use the SSA_ prefix (Store Staffing Analyzer).

# Monthly fixed salary per salesperson, in Lakhs INR (1 Lakh = 100,000 INR)
SSA_SALARY=3.0

# Commission paid to staff as a fraction of monthly sales (0.05 = 5%)
SSA_COMMISSION=0.05

# Cost of goods sold as a fraction of sales (0.50 = 50%)
SSA_COGS=0.50

# Length of the forward-looking forecast horizon, in months
SSA_FORECAST_MONTHS=6

# Random seed for the Monte-Carlo simulation (reproducible results)
SSA_SEED=42

# Comma-separated list of allowed CORS origins ("*" allows any origin)
SSA_CORS_ORIGINS=*

# HTTP port used by the application server
PORT=8000
